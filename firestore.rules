rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function self(uid) { return signedIn() && request.auth.uid == uid; }
    function roles() { return signedIn() && request.auth.token.roles is list ? request.auth.token.roles : []; }
    function hasRole(role) { return signedIn() && role in roles(); }
    function hasAnyRole(allowed) { return signedIn() && roles().hasAny(allowed); }
    function activeUser() { return signedIn() && request.auth.token.suspended != true; }
    function admin() { return hasAnyRole(['SUPER_ADMIN', 'ADMIN']); }
    function finance() { return hasAnyRole(['SUPER_ADMIN', 'ADMIN', 'FINANCE_OFFICER']); }
    function team() { return hasAnyRole(['SUPER_ADMIN', 'ADMIN', 'TEAM_MANAGER', 'JOB_VERIFICATION_OFFICER', 'EMPLOYER_VERIFICATION_OFFICER', 'RECRUITMENT_OFFICER', 'CUSTOMER_SUPPORT', 'FINANCE_OFFICER', 'CONTENT_MANAGER']); }

    match /users/{uid} {
      allow read: if self(uid) || admin();
      allow create: if false;
      allow update: if self(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fullName','phone','photoUrl','updatedAt']);
      allow delete: if false;
    }

    match /jobSeekers/{uid} {
      allow read, create, update: if self(uid) || admin();
      allow delete: if admin();
    }

    match /employers/{uid} {
      allow read: if self(uid) || team();
      allow create: if self(uid) && request.resource.data.status == 'PENDING';
      allow update: if self(uid) && request.resource.data.status == resource.data.status || hasAnyRole(['SUPER_ADMIN','ADMIN','EMPLOYER_VERIFICATION_OFFICER']);
      allow delete: if admin();
    }

    match /teamMembers/{uid} {
      allow read: if self(uid) || admin() || hasRole('TEAM_MANAGER');
      allow write: if false;
    }

    match /jobs/{jobId} {
      allow read: if resource.data.status == 'PUBLISHED' || team() || (signedIn() && resource.data.employerId == request.auth.uid);
      allow write: if false;
      match /private/{docId} { allow read, write: if false; }
      match /reviewHistory/{docId} { allow read: if team() || (signedIn() && get(/databases/$(database)/documents/jobs/$(jobId)).data.employerId == request.auth.uid); allow write: if false; }
    }

    match /jobCategories/{id} { allow read: if true; allow write: if admin(); }
    match /countries/{id} { allow read: if true; allow write: if admin(); }
    match /cities/{id} { allow read: if true; allow write: if admin(); }
    match /skills/{id} { allow read: if true; allow write: if admin(); }

    match /bankAccounts/{id} { allow read, write: if false; }

    match /payments/{id} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || finance());
      allow write: if false;
    }
    match /paymentVerifications/{id} { allow read: if finance(); allow write: if false; }
    match /jobAccess/{id} { allow read: if signedIn() && (resource.data.userId == request.auth.uid || admin()); allow write: if false; }
    match /transactions/{id} { allow read: if signedIn() && (resource.data.userId == request.auth.uid || finance()); allow write: if false; }
    match /receipts/{id} { allow read: if signedIn() && (resource.data.userId == request.auth.uid || finance()); allow write: if false; }

    match /savedJobs/{id} {
      allow read, delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if activeUser() && request.resource.data.userId == request.auth.uid;
      allow update: if false;
    }
    match /jobAlerts/{id} {
      allow read, update, delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if activeUser() && request.resource.data.userId == request.auth.uid;
    }
    match /notifications/{id} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow update: if signedIn() && resource.data.userId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read','readAt']);
      allow create, delete: if false;
    }

    match /cvProfiles/{id} {
      allow read, delete: if activeUser() && resource.data.userId == request.auth.uid;
      allow create: if activeUser() && request.resource.data.userId == request.auth.uid;
      allow update: if activeUser() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
    }
    match /cvVersions/{id} {
      allow read, delete: if activeUser() && resource.data.userId == request.auth.uid;
      allow create: if activeUser() && request.resource.data.userId == request.auth.uid;
      allow update: if activeUser() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
    }
    match /coverLetters/{id} {
      allow read, delete: if activeUser() && resource.data.userId == request.auth.uid;
      allow create: if activeUser() && request.resource.data.userId == request.auth.uid;
      allow update: if activeUser() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
    }

    match /supportTickets/{id} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || hasAnyRole(['SUPER_ADMIN','ADMIN','CUSTOMER_SUPPORT']));
      allow create: if activeUser() && request.resource.data.userId == request.auth.uid && request.resource.data.status == 'OPEN';
      allow update: if hasAnyRole(['SUPER_ADMIN','ADMIN','CUSTOMER_SUPPORT']);
      allow delete: if false;
      match /messages/{messageId} {
        allow read: if signedIn() && (get(/databases/$(database)/documents/supportTickets/$(id)).data.userId == request.auth.uid || hasAnyRole(['SUPER_ADMIN','ADMIN','CUSTOMER_SUPPORT']));
        allow create: if activeUser() && request.resource.data.senderId == request.auth.uid
          && (get(/databases/$(database)/documents/supportTickets/$(id)).data.userId == request.auth.uid
            || hasAnyRole(['SUPER_ADMIN','ADMIN','CUSTOMER_SUPPORT']));
        allow update, delete: if false;
      }
    }

    match /cmsPages/{id} { allow read: if resource.data.status == 'PUBLISHED' || admin() || hasRole('CONTENT_MANAGER'); allow write: if admin() || hasRole('CONTENT_MANAGER'); }
    match /banners/{id} { allow read: if resource.data.active == true; allow write: if admin() || hasRole('CONTENT_MANAGER'); }
    match /settings/{id} { allow read: if signedIn() && resource.data.public == true; allow write: if admin(); }
    match /externalSources/{id} { allow read: if signedIn(); allow write: if team(); }
    match /auditLogs/{id} { allow read: if hasRole('SUPER_ADMIN') || hasRole('ADMIN'); allow write: if false; }
    match /aiRequests/{id} { allow read: if signedIn() && (resource.data.userId == request.auth.uid || admin()); allow write: if false; }
    match /rateLimits/{id} { allow read, write: if false; }
  }
}
